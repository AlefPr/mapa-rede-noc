# ============================================
# nfacctd.conf — pmacct 1.7.8 (NetFlow/IPFIX collector)
# MULTI-DISPOSITIVO: identifica o exportador via pre_tag_map
#
# O pmacct 1.7.x NÃO suporta nfacctd_agents_file (é v12+) nem a
# diretiva 'agent_id' no nfacctd (é de pmacctd/sfacctd e quebra o
# daemon). O jeito correto de estampar a origem dos fluxos:
#
#   1) no aggregate, use o pseudo-primitivo 'tag';
#   2) defina pre_tag_map apontando para um arquivo que mapeia o
#      IP de origem dos pacotes NetFlow/IPFIX -> set_tag;
#   3) o pmacct grava o valor de 'tag' na coluna 'agent_id' do SQL
#      (tabelas padrão com sql_table_version < 9), que casa com
#      flow_data.equipamentos.agent_id.
#
# Exemplo de /etc/pmacct/pretag.map (uma regra por exportador):
#
#   set_tag=1 ip=192.168.254.1     ! Borda-Principal
#   set_tag=2 ip=192.168.254.2     ! Core-02
#
# Recarregue o mapa sem reiniciar: killall -USR2 nfacctd
# ============================================
daemonize: true
pidfile: /var/run/nfacctd.pid
logfile: /var/log/pmacct/nfacctd.log

nfacctd_port: 2055
nfacctd_ip: 0.0.0.0

# Mapa exportador (IP de origem) -> tag (vira agent_id no SQL)
pre_tag_map: /etc/pmacct/pretag.map

# 'tag' identifica o equipamento de origem do fluxo
aggregate: src_host, dst_host, src_port, dst_port, proto, tag

plugins: mysql

sql_host: localhost
sql_db: flow_data
sql_user: mapa_user
sql_passwd: uma_senha_forte_aqui
sql_table: flow_bruto
sql_table_version: 1
sql_refresh_time: 60
sql_history: 5m
sql_history_roundoff: m
sql_dont_try_update: true
sql_optimize_clauses: true
